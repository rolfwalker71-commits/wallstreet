# App
APP_NAME=Wallstreet
APP_ENV=development
APP_PORT=4499
BACKEND_PORT=8000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=wallstreet
POSTGRES_PASSWORD=wallstreet
POSTGRES_DB=wallstreet
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://wallstreet:wallstreet@db:5432/wallstreet

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI (Multi-Agenten)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini

# Paper-Trading
DEFAULT_CASH=100000
DEFAULT_CURRENCY=USD

# Scheduler
AGENT_CRON_MINUTES=30
WATCHLIST=AAPL,MSFT,NVDA,VOO,BTC-USD,ETH-USD

# Web-Push (VAPID wird automatisch in der DB erzeugt)
VAPID_SUBJECT=mailto:wallstreet@localhost

# GHCR (compose image prefix, ohne Tag)
GHCR_OWNER=rolf
TAG=latest